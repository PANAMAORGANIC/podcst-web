# Hosted likes stay in the browser (localStorage). POST /api/likes writes
# data/sources/liked.json only when the disk is writable (local ingest).
# Do not rely on that file on Railway / Render / Fly / Vercel.

# Optional live translator (LibreTranslate-compatible).
# Without these, the app uses curated English fields in the seed catalog.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Ingest (metadata + deep links only). No database required.
# Optional override for every ingest script. Unset to use each default
# (podcasts 25000, audiobooks 400, youtube all curated channels). 50k–100k dump passes are
# supported; the app loads data/catalog.json.gz so git stays small.
INGEST_LIMIT=

# Podcasts — both strategies run from `npm run ingest:podcasts`:
#   1. Podcast Index dump when a file is present or DOWNLOAD=1
#   2. Apple / iTunes storefront harvest (default on)
PODCASTINDEX_DUMP_URL=https://public.podcastindex.org/podcastindex_feeds.db.tgz
# Local extracted SQLite file. If set and present, ingest uses it.
PODCASTINDEX_DUMP_PATH=
# Set to 1 to download the official dump (about 1.8GB). Off by default.
PODCASTINDEX_DOWNLOAD=
# Set to 0 to skip the Apple / iTunes harvest.
ITUNES_HARVEST=
# Boost listed languages in dump + Apple harvest (comma-separated).
# Still keeps a diversity floor for other languages.
# Example big en/es pass:
# PODCASTINDEX_DOWNLOAD=1 INGEST_LIMIT=100000 INGEST_FOCUS=en,es npm run ingest:podcasts
INGEST_FOCUS=
# Optional Podcast Index API. Free keys from https://api.podcastindex.org/
# Used by podcast ingest (bounded search) and `npm run ingest:recommend`
# (related/similar by feed URL or iTunes id). Do not invent or commit keys.
# Without keys, recommend ingest still uses the local dump + Apple Search.
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
# Favorites: curated RSS hubs in data/sources/favorites.json.
# FAVORITES_EXPAND=0 skips Pacifica / public-radio iTunes cards.
# FAVORITE_PINS='Title One|Title Two' search-and-pins extra shows.
FAVORITES_EXPAND=
FAVORITE_PINS=
# Optional Postgres is unused by the file-based catalog store.
DATABASE_URL=

# Optional YouTube Data API (metadata only). Never invent or commit keys.
# Without a key, ingest still writes the checked-in channel list
# (data/sources/youtube-channels.json — 400+ podcast/lecture channels).
# Homepage / recommendation HTML on youtube.com is out of scope.
# See docs/youtube-signals.md for Google Cloud setup.
YOUTUBE_API_KEY=
# Later: OAuth for subscriptions.list and videos.list?myRating=like.
# An API key cannot read private mine=true lists. Leave empty until you
# complete the Cloud Console consent flow and receive a refresh token.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# Epsilon-greedy explore rate for For You / Because you like / Explore.
# 0 is fully greedy; 1 is uniform inside the related neighborhood.
# Default 0.2. Does not sample unrelated world-directory shelves.
FOR_YOU_RANDOMNESS=0.2

# Optional agent feed webhook. Copy and download work without this.
# POST { packet, markdown } to the URL when the user clicks Send to webhook.
AGENT_FEED_WEBHOOK_URL=
# Optional secret sent as a header. Do not invent or commit a real value.
AGENT_FEED_WEBHOOK_SECRET=
# Header name for the secret. Defaults to X-Agent-Feed-Secret.
AGENT_FEED_WEBHOOK_HEADER=X-Agent-Feed-Secret
