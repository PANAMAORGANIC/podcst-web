# Optional live translator (LibreTranslate-compatible).
# Without these, the app uses curated English fields in the seed catalog.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Optional podcast ingest (Podcast Index dump → catalog store).
# The demo app does not need a database.
DATABASE_URL=
PODCASTINDEX_DUMP_URL=https://public.podcastindex.org/podcastindex_feeds.db.tgz
INGEST_LIMIT=200

# Optional YouTube Data API for later metadata ingest. Never required to run the app.
YOUTUBE_API_KEY=

# Optional agent feed webhook. Copy and download work without this.
# POST { packet, markdown } to the URL when the user clicks Send to webhook.
AGENT_FEED_WEBHOOK_URL=
# Optional secret sent as a header. Do not invent or commit a real value.
AGENT_FEED_WEBHOOK_SECRET=
# Header name for the secret. Defaults to X-Agent-Feed-Secret.
AGENT_FEED_WEBHOOK_HEADER=X-Agent-Feed-Secret
