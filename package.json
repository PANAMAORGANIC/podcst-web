{
  "name": "world-audio-repository",
  "version": "1.0.0",
  "private": true,
  "description": "A global catalogue of podcasts, audiobooks, and long-form YouTube.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src scripts",
    "format": "biome format --write src scripts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/catalog/query.test.ts src/catalog/store.test.ts src/catalog/taxonomy.test.ts src/translation/local.test.ts src/agent-feed/packet.test.ts",
    "ingest:podcasts": "tsx scripts/ingest-podcast-index.ts",
    "ingest:audiobooks": "tsx scripts/ingest-audiobooks.ts",
    "ingest:youtube": "tsx scripts/ingest-youtube.ts"
  },
  "dependencies": {
    "match-sorter": "8.3.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.20.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
